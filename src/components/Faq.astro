---
const faqs = [
  { q: 'Dex AGENT 是官方产品吗？', a: '不是。Dex AGENT 是独立产品，与模型厂商无隶属关系。' },
  { q: '数据会上传吗？', a: '本地优先。工作区与会话数据留在本机；只有模型调用会发送到你配置的模型服务。' },
  { q: '支持哪些模型？', a: '支持多家模型适配器热插拔，包含 OpenAI 兼容端点。具体模型接入方式会在内测配置说明中提供。' },
  { q: '是否开源？', a: '当前仓库未公开，官网不提供源码下载。' },
  { q: '需要什么环境？', a: '桌面环境即可（Windows / macOS / Linux）。模型调用需要网络，以及你所配置模型服务的 API Key。' },
  { q: '什么时候开放下载？', a: '内测预约开放中，具体时间以邮件通知为准。' },
  { q: '可以取消正在执行的任务吗？', a: '当前版本仍在完善任务控制能力，后续版本会补齐。' },
]
---

<div class="faq2">
  {faqs.map((item, index) => (
    <details {...(index === 0 ? { open: true } : {})}>
      <summary>{item.q}</summary>
      <p>{item.a}</p>
    </details>
  ))}
</div>
