---
interface Props {
  secondaryHref?: string
  secondaryLabel?: string
}

const {
  secondaryHref = '/observe/',
  secondaryLabel = '看它如何工作',
} = Astro.props
---

<section class="cta-black">
  <div class="container cta-inner">
    <div>
      <p class="eyebrow">OPEN THE LOOP / 打开回路</p>
      <h2>把回路<br />装进桌面。</h2>
      <p>v0.2.1 Windows 公共预览版已开放下载。macOS / Linux 仍在准备中。</p>
      <div class="actions">
        <a class="btn btn-primary" href="/download/">下载 Windows 版</a>
        <a class="text-link" href={secondaryHref}>{secondaryLabel}</a>
      </div>
    </div>
    <div class="cta-side">
      <b>DEX AGENT / v0.2.1</b><br />
      WINDOWS X64 · MACOS / LINUX SOON<br />
      INDEPENDENT PRODUCT<br />
      FIELD MANUAL 001 / 2026
    </div>
  </div>
</section>
