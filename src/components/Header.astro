---
interface Props {
  current: string
}

const { current } = Astro.props
const links = [
  { href: '/', label: '首页' },
  { href: '/observe/', label: '观测' },
  { href: '/download/', label: '下载' },
  { href: '/about/', label: '关于' },
]
const isCurrent = (href: string) => current === href || (href !== '/' && current.startsWith(href))
---

<header class="site-head">
  <div class="container head-inner">
    <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"></span>Dex AGENT</a>
    <nav class="nav" aria-label="主导航">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="head-actions">
      <span class="head-meta">FIELD MANUAL / 001</span>
      <a class="btn btn-primary" href="/download/">下载 Dex AGENT</a>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-label="打开导航"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <button class="icon-btn close menu-close" type="button" aria-label="关闭导航">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
  </button>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
  <div class="m-actions"><a class="btn btn-primary" href="/download/">下载 Dex AGENT</a></div>
  <div class="m-note">DEX AGENT / FIELD MANUAL 001 / 2026</div>
</div>
